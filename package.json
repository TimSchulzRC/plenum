{
  "name": "plenum",
  "productName": "Plenum",
  "version": "0.1.0",
  "description": "Desktop-Client für Microsoft Teams mit Mail und Kalender, der die Teams-Web-App als Datenquelle nutzt",
  "main": "./out/main/index.js",
  "author": "Tim Schulz",
  "license": "MIT",
  "homepage": "https://github.com/TimSchulzRC/plenum",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TimSchulzRC/plenum.git"
  },
  "bugs": {
    "url": "https://github.com/TimSchulzRC/plenum/issues"
  },
  "engines": {
    "node": ">=22.12"
  },
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "node scripts/dev-app.mjs && electron-vite dev",
    "build": "electron-vite build",
    "start": "node scripts/dev-app.mjs && electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "bench:call": "node scripts/call-bench/run.mjs",
    "dist": "electron-vite build && electron-builder --mac --dir",
    "dist:dmg": "electron-vite build && electron-builder --mac dmg",
    "dist:release": "electron-vite build && electron-builder --mac dmg zip --arm64 --x64 --publish never",
    "icons": "node scripts/icons.mjs",
    "teams-emoji": "node scripts/teams-emoji.mjs"
  },
  "devDependencies": {
    "@fluentui/react-components": "^9.75.2",
    "@fluentui/react-icons": "^2.0.346",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "date-fns": "^4.1.0",
    "dompurify": "^3.2.0",
    "electron": "45.3.4",
    "electron-builder": "^26.0.0",
    "electron-vite": "^6.0.0",
    "posthog-node": "6.0.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~7.0.2",
    "vite": "^8.0.0",
    "zustand": "^5.0.0"
  },
  "build": {
    "appId": "io.github.timschulzrc.teamseverywhere",
    "productName": "Plenum",
    "artifactName": "Plenum-${version}-mac-${arch}.${ext}",
    "copyright": "Copyright © 2026 Tim Schulz",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.business",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSCameraUsageDescription": "Plenum braucht die Kamera für Video in Anrufen und Besprechungen.",
        "NSMicrophoneUsageDescription": "Plenum braucht das Mikrofon für Anrufe und Besprechungen.",
        "NSAudioCaptureUsageDescription": "Plenum überträgt beim Teilen des Bildschirms auf Wunsch den Systemton.",
        "LSApplicationCategoryType": "public.app-category.business",
        "CFBundleURLTypes": []
      }
    },
    "dmg": {
      "title": "Plenum ${version}"
    }
  }
}
